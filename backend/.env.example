# Either set DATABASE_URL ...
# DATABASE_URL=postgres://keyvault:keyvault@127.0.0.1:5432/keyvault
# ... or the individual values:
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=keyvault
DB_USER=keyvault
DB_PASSWORD=keyvault

# Database used by the test suite (it is wiped on every test run!)
DB_TEST_NAME=keyvault_test

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Show exception messages in 500 responses (never enable in production)
APP_DEBUG=true
